{
  "name": "modern-core/theme",
  "description": "Production-ready enterprise WooCommerce theme.",
  "type": "wordpress-theme",
  "license": "GPL-2.0-or-later",
  "minimum-stability": "stable",
  "require": {
    "php": ">=8.2"
  },
  "require-dev": {
    "phpunit/phpunit": "^10.0",
    "squizlabs/php_codesniffer": "^3.7"
  },
  "autoload": {
    "psr-4": {
      "ModernCore\\": "inc/"
    }
  },
  "config": {
    "optimize-autoloader": true,
    "sort-packages": true
  }
}
