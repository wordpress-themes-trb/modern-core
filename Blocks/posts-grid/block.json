{
  "$schema": "https://schemas.wp.org/trunk/block.json",
  "apiVersion": 3,
  "name": "modern-core/posts-grid",
  "title": "Blog / Posts Grid",
  "category": "modern-core",
  "icon": "welcome-widgets-menus",
  "description": "Editorial content marketing display with advanced querying.",
  "supports": {
    "align": ["wide", "full"],
    "html": false
  },
  "attributes": {
    "sectionTitle": { "type": "string", "default": "From the blog" },
    "sectionLink": { "type": "string", "default": "/blog" },
    "queryCount": { "type": "number", "default": 6 },
    "postType": { "type": "string", "default": "post" },
    "layoutMode": { "type": "string", "default": "grid" },
    "colsDesktop": { "type": "number", "default": 3 },
    "imageRatio": { "type": "string", "default": "16/9" },
    "showCategory": { "type": "boolean", "default": true },
    "showDate": { "type": "boolean", "default": true },
    "showAuthor": { "type": "boolean", "default": true },
    "showExcerpt": { "type": "boolean", "default": true },
    "showReadTime": { "type": "boolean", "default": true },
    "excerptLength": { "type": "number", "default": 15 },
    "cardRadius": { "type": "number", "default": 8 },
    "accentColor": { "type": "string", "default": "#0f172a" },
    "textColor": { "type": "string", "default": "#64748b" }
  },
  "textdomain": "modern-core",
  "editorScript": "modern-core-posts-grid-js",
  "render": "file:./render.php"
}
