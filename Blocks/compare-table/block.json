{
    "$schema": "https://schemas.wp.org/trunk/block.json",
    "apiVersion": 3,
    "name": "modern-core/compare-table",
    "title": "Compare Table",
    "category": "modern-core",
    "icon": "columns",
    "description": "High-density, sticky-header product comparison matrix.",
    "supports": {
        "align": [
            "wide",
            "full"
        ],
        "html": false
    },
    "attributes": {
        "sourceMode": {
            "type": "string",
            "default": "dynamic"
        },
        "staticProducts": {
            "type": "string",
            "default": ""
        },
        "maxColumns": {
            "type": "number",
            "default": 4
        },
        "labelWidth": {
            "type": "number",
            "default": 20
        },
        "isSticky": {
            "type": "boolean",
            "default": true
        },
        "alternateRows": {
            "type": "boolean",
            "default": true
        },
        "showImage": {
            "type": "boolean",
            "default": true
        },
        "showPrice": {
            "type": "boolean",
            "default": true
        },
        "showRating": {
            "type": "boolean",
            "default": true
        },
        "showAtc": {
            "type": "boolean",
            "default": true
        },
        "imageRatio": {
            "type": "string",
            "default": "1/1"
        },
        "tableRadius": {
            "type": "number",
            "default": 12
        },
        "headerBg": {
            "type": "string",
            "default": "#ffffff"
        },
        "rowOddBg": {
            "type": "string",
            "default": "#ffffff"
        },
        "rowEvenBg": {
            "type": "string",
            "default": "#f8fafc"
        },
        "borderColor": {
            "type": "string",
            "default": "#e2e8f0"
        },
        "accentColor": {
            "type": "string",
            "default": "#3b82f6"
        },
        "widthMode": {
            "type": "string",
            "default": "contained",
            "enum": [
                "contained",
                "wide",
                "fullwidth"
            ]
        }
    },
    "textdomain": "modern-core",
    "editorScript": "modern-core-compare-js",
    "render": "file:./render.php"
}
