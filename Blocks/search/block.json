{
  "$schema": "https://schemas.wp.org/trunk/block.json",
  "apiVersion": 3,
  "name": "modern-core/search",
  "title": "Advanced Search",
  "category": "modern-core",
  "icon": "search",
  "description": "A live-suggest search bar with customizable shape and icons.",
  "attributes": {
    "placeholder": {
      "type": "string",
      "default": "Search for products..."
    },
    "shape": {
      "type": "string",
      "default": "pill"
    },
    "showIcon": {
      "type": "boolean",
      "default": true
    },
    "iconPosition": {
      "type": "string",
      "default": "right"
    },
    "bgColor": {
      "type": "string",
      "default": "#f4f4f5"
    },
    "textColor": {
      "type": "string",
      "default": "#000000"
    },
    "width": {
      "type": "number",
      "default": 100
    },
    "trendingTags": {
      "type": "string",
      "default": "Minimalist Watch, Canvas Tote, Linen Shirt"
    }
  },
  "textdomain": "modern-core",
  "editorScript": "modern-core-search-js",
  "render": "file:./render.php"
}
