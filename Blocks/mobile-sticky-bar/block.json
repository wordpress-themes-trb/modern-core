{
  "$schema": "https://schemas.wp.org/trunk/block.json",
  "apiVersion": 3,
  "name": "modern-core/mobile-sticky-bar",
  "title": "Mobile Sticky Bar",
  "category": "modern-core",
  "icon": "smartphone",
  "description": "App-like bottom navigation with contextual Product and Cart modes.",
  "supports": {
    "html": false,
    "align": ["full"]
  },
  "attributes": {
    "bgColor": { "type": "string", "default": "rgba(15, 23, 42, 0.85)" },
    "iconColor": { "type": "string", "default": "#94a3b8" },
    "activeColor": { "type": "string", "default": "#ffffff" },
    "centerBtnBg": { "type": "string", "default": "#3b82f6" },
    "centerBtnIcon": { "type": "string", "default": "#ffffff" },
    "blurIntensity": { "type": "number", "default": 15 },
    "autoHide": { "type": "boolean", "default": true },
    "showOnDesktop": { "type": "boolean", "default": false },
    "cartDrawerId": { "type": "string", "default": "mc-drawer-1" },
    "enableProductMode": { "type": "boolean", "default": true },
    "enableCartMode": { "type": "boolean", "default": true },
    "checkoutBehavior": { "type": "string", "default": "hide" },
    "searchHeading": { "type": "string", "default": "Trending Searches" },
    "searchTrending": {
      "type": "string",
      "default": "Sneakers, Jackets, Watches"
    }
  },
  "textdomain": "modern-core",
  "editorScript": "modern-core-stickybar-js",
  "render": "file:./render.php"
}
