{
  "$schema": "https://schemas.wp.org/trunk/block.json",
  "apiVersion": 3,
  "name": "modern-core/order-confirmation",
  "title": "Order Confirmation",
  "category": "modern-core",
  "icon": "smiley",
  "description": "Celebratory, retention-building post-purchase experience.",
  "supports": {
    "align": ["wide", "full"],
    "html": false
  },
  "attributes": {
    "animType": { "type": "string", "default": "checkmark" },
    "headline": { "type": "string", "default": "Thank you for your order!" },
    "message": {
      "type": "string",
      "default": "We've received your order and are getting it ready to ship. We will send you an email with tracking information shortly."
    },
    "showTimeline": { "type": "boolean", "default": true },
    "showCrossSells": { "type": "boolean", "default": true },
    "showReferral": { "type": "boolean", "default": true },
    "referralText": {
      "type": "string",
      "default": "Give $10, Get $10. Share this link with a friend!"
    },
    "cardBg": { "type": "string", "default": "#ffffff" },
    "cardRadius": { "type": "number", "default": 12 },
    "accentColor": { "type": "string", "default": "#10b981" },
    "textColor": { "type": "string", "default": "#0f172a" },
    "borderColor": { "type": "string", "default": "#e2e8f0" }
  },
  "textdomain": "modern-core",
  "editorScript": "modern-core-order-confirmation-js",
  "render": "file:./render.php"
}
