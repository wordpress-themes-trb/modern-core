{
  "$schema": "https://schemas.wp.org/trunk/block.json",
  "apiVersion": 3,
  "name": "modern-core/cart-page",
  "title": "Cart Page Layout",
  "category": "modern-core",
  "icon": "cart",
  "description": "Conversion-optimized cart environment with real-time auto-updates.",
  "supports": {
    "align": ["wide", "full"],
    "html": false
  },
  "attributes": {
    "layoutMode": { "type": "string", "default": "two-column" },
    "showHeaders": { "type": "boolean", "default": true },
    "autoUpdate": { "type": "boolean", "default": true },
    "summaryBg": { "type": "string", "default": "#f8fafc" },
    "summaryRadius": { "type": "number", "default": 12 },
    "accentColor": { "type": "string", "default": "#3b82f6" },
    "textColor": { "type": "string", "default": "#0f172a" },
    "borderColor": { "type": "string", "default": "#e2e8f0" }
  },
  "textdomain": "modern-core",
  "editorScript": "modern-core-cart-page-js",
  "render": "file:./render.php"
}
