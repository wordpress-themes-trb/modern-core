{
    "$schema": "https://schemas.wp.org/trunk/block.json",
    "apiVersion": 3,
    "name": "modern-core/wishlist",
    "title": "Wishlist Engine",
    "category": "modern-core",
    "icon": "heart",
    "description": "Cache-busting, high-conversion saved items display.",
    "supports": {
        "align": [
            "wide",
            "full"
        ],
        "html": false
    },
    "attributes": {
        "layoutMode": {
            "type": "string",
            "default": "grid"
        },
        "gridCols": {
            "type": "number",
            "default": 4
        },
        "showStock": {
            "type": "boolean",
            "default": true
        },
        "showPriceDrop": {
            "type": "boolean",
            "default": true
        },
        "showShare": {
            "type": "boolean",
            "default": true
        },
        "emptyHeading": {
            "type": "string",
            "default": "Your wishlist is empty"
        },
        "emptyMessage": {
            "type": "string",
            "default": "Save items you love to review them later."
        },
        "emptyButton": {
            "type": "string",
            "default": "Start Shopping"
        },
        "emptyLink": {
            "type": "string",
            "default": "/shop"
        },
        "accentColor": {
            "type": "string",
            "default": "#0f172a"
        },
        "widthMode": {
            "type": "string",
            "default": "contained",
            "enum": [
                "contained",
                "wide",
                "fullwidth"
            ]
        }
    },
    "textdomain": "modern-core",
    "editorScript": "modern-core-wishlist-js",
    "render": "file:./render.php"
}
