{
  "$schema": "https://schemas.wp.org/trunk/block.json",
  "apiVersion": 3,
  "name": "modern-core/trust-strip",
  "title": "Trust Indicators",
  "category": "modern-core",
  "icon": "shield",
  "description": "A horizontal row of conversion-boosting trust signals.",
  "attributes": {
    "item1": { "type": "string", "default": "Free Worldwide Shipping" },
    "item2": { "type": "string", "default": "30-Day Easy Returns" },
    "item3": { "type": "string", "default": "Secure SSL Checkout" },
    "item4": { "type": "string", "default": "24/7 Customer Support" },
    "iconSize": { "type": "number", "default": 16 },
    "fontSize": { "type": "number", "default": 12 },
    "gap": { "type": "number", "default": 24 },
    "showDividers": { "type": "boolean", "default": true },
    "textColor": { "type": "string", "default": "inherit" },
    "iconColor": { "type": "string", "default": "#3b82f6" },
    "alignment": { "type": "string", "default": "center" }
  },
  "textdomain": "modern-core",
  "editorScript": "modern-core-trust-js",
  "render": "file:./render.php"
}
