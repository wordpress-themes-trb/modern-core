{
  "$schema": "https://schemas.wp.org/trunk/block.json",
  "apiVersion": 3,
  "name": "modern-core/product-grid",
  "title": "Advanced Product Grid",
  "category": "modern-core",
  "icon": "grid-view",
  "description": "High-conversion product grid with dynamic queries and custom card designs.",
  "supports": {
    "align": ["wide", "full"],
    "html": false
  },
  "attributes": {
    "productCount": {
      "type": "number",
      "default": 8
    },
    "querySort": {
      "type": "string",
      "default": "date"
    },
    "layoutMode": {
      "type": "string",
      "default": "grid"
    },
    "columnsDesktop": {
      "type": "number",
      "default": 4
    },
    "columnsTablet": {
      "type": "number",
      "default": 3
    },
    "columnsMobile": {
      "type": "number",
      "default": 2
    },
    "imageRatio": {
      "type": "string",
      "default": "3/4"
    },
    "imageHover": {
      "type": "string",
      "default": "zoom"
    },
    "cardRadius": {
      "type": "number",
      "default": 8
    },
    "cardBg": {
      "type": "string",
      "default": "#ffffff"
    },
    "cardHoverLift": {
      "type": "boolean",
      "default": true
    },
    "showCategory": {
      "type": "boolean",
      "default": false
    },
    "showRating": {
      "type": "boolean",
      "default": true
    },
    "saleBadgeStyle": {
      "type": "string",
      "default": "pill"
    },
    "atcStyle": {
      "type": "string",
      "default": "solid"
    },
    "atcPosition": {
      "type": "string",
      "default": "below"
    },
    "showToolbar": {
      "type": "boolean",
      "default": true
    },
    "paginationType": {
      "type": "string",
      "default": "load-more"
    },
    "accentColor": {
      "type": "string",
      "default": "#000000"
    }
  },
  "textdomain": "modern-core",
  "editorScript": "modern-core-product-grid-js",
  "render": "file:./render.php"
}
