{
  "name": "modern-core",
  "version": "1.0.0",
  "private": true,
  "description": "Modern Core: WooCommerce block theme",
  "type": "module",
  "scripts": {
    "dev": "vite build --watch --mode development",
    "build": "vite build --mode production && node scripts/build-elementor-map.mjs",
    "lint:js": "eslint \"blocks/**/*.{js,jsx}\" \"assets/src/js/**/*.js\"",
    "lint:scss": "stylelint \"**/*.scss\"",
    "format": "prettier --write \"**/*.{js,jsx,scss,json,php}\"",
    "makepot": "wp i18n make-pot . languages/modern-core.pot --ignore-domain",
    "test:php": "./vendor/bin/phpunit",
    "test:js": "jest",
    "test:e2e": "playwright test",
    "validate": "python3 scripts/validate-templates.py",
    "package": "bash scripts/package.sh"
  },
  "devDependencies": {
    "@lhci/cli": "^0.13.0",
    "@playwright/test": "^1.40.0",
    "@testing-library/jest-dom": "^6.1.4",
    "@testing-library/react": "^14.1.2",
    "@vitejs/plugin-react": "^4.7.0",
    "@wordpress/eslint-plugin": "^17.0.0",
    "@wordpress/html-entities": "^4.47.0",
    "autoprefixer": "^10.4.16",
    "cssnano": "^6.0.1",
    "eslint": "^8.52.0",
    "jest": "^29.7.0",
    "jest-environment-jsdom": "^29.7.0",
    "postcss": "^8.4.31",
    "prettier": "^3.0.3",
    "rollup-plugin-external-globals": "^0.13.0",
    "sass": "^1.69.0",
    "stylelint": "^15.11.0",
    "stylelint-config-standard-scss": "^11.0.0",
    "vite": "^5.0.0"
  },
  "dependencies": {
    "aos": "^2.3.4"
  }
}
