{
  "$schema": "https://schemas.wp.org/trunk/theme.json",
  "version": 2,
  "settings": {
    "appearanceTools": true,
    "layout": {
      "contentSize": "800px",
      "wideSize": "1200px"
    },
    "color": {
      "custom": false,
      "customGradient": false,
      "defaultPalette": false,
      "defaultGradients": false,
      "palette": [
        {
          "slug": "base",
          "color": "#ffffff",
          "name": "Base (Background)"
        },
        {
          "slug": "contrast",
          "color": "#0f172a",
          "name": "Contrast (Text/Dark)"
        },
        {
          "slug": "accent",
          "color": "#e2b57a",
          "name": "Accent (Gold/Action)"
        },
        {
          "slug": "neutral-light",
          "color": "#f8fafc",
          "name": "Neutral Light (Sections)"
        },
        {
          "slug": "neutral-border",
          "color": "#e2e8f0",
          "name": "Neutral Border"
        },
        {
          "slug": "neutral-text",
          "color": "#64748b",
          "name": "Neutral Text (Subtitles)"
        },
        {
          "slug": "error",
          "color": "#ef4444",
          "name": "Error / Sale Badge"
        },
        {
          "slug": "success",
          "color": "#10b981",
          "name": "Success"
        }
      ]
    },
    "typography": {
      "customFontSize": false,
      "dropCap": false,
      "fontStyle": true,
      "fontWeight": true,
      "fontFamilies": [
        {
          "fontFamily": "Inter, -apple-system, BlinkMacSystemFont, 'Segoe UI', Roboto, Helvetica, Arial, sans-serif",
          "name": "Primary Sans",
          "slug": "primary"
        },
        {
          "fontFamily": "'Playfair Display', Georgia, serif",
          "name": "Editorial Serif",
          "slug": "secondary"
        }
      ],
      "fontSizes": [
        {
          "slug": "xs",
          "size": "0.75rem",
          "name": "Extra Small"
        },
        {
          "slug": "sm",
          "size": "0.875rem",
          "name": "Small"
        },
        {
          "slug": "base",
          "size": "1rem",
          "name": "Base / Body"
        },
        {
          "slug": "lg",
          "size": "1.125rem",
          "name": "Large"
        },
        {
          "slug": "xl",
          "size": "1.5rem",
          "name": "Extra Large"
        },
        {
          "slug": "xxl",
          "size": "2.25rem",
          "name": "2XL / Heading 2"
        },
        {
          "slug": "xxxl",
          "size": "3rem",
          "name": "3XL / Heading 1"
        },
        {
          "slug": "hero",
          "size": "4.5rem",
          "name": "Hero Display"
        }
      ]
    },
    "spacing": {
      "blockGap": true,
      "margin": true,
      "padding": true,
      "units": ["px", "em", "rem", "vh", "vw", "%"],
      "spacingScale": {
        "steps": 0
      },
      "spacingSizes": [
        {
          "name": "4px",
          "size": "0.25rem",
          "slug": "xs"
        },
        {
          "name": "8px",
          "size": "0.5rem",
          "slug": "sm"
        },
        {
          "name": "16px",
          "size": "1rem",
          "slug": "md"
        },
        {
          "name": "24px",
          "size": "1.5rem",
          "slug": "lg"
        },
        {
          "name": "40px",
          "size": "2.5rem",
          "slug": "xl"
        },
        {
          "name": "64px",
          "size": "4rem",
          "slug": "xxl"
        },
        {
          "name": "100px",
          "size": "6.25rem",
          "slug": "xxxl"
        }
      ]
    }
  },
  "styles": {
    "color": {
      "background": "var(--wp--preset--color--base)",
      "text": "var(--wp--preset--color--contrast)"
    },
    "typography": {
      "fontFamily": "var(--wp--preset--font-family--primary)",
      "fontSize": "var(--wp--preset--font-size--base)",
      "lineHeight": "1.6"
    },
    "elements": {
      "link": {
        "color": {
          "text": "var(--wp--preset--color--contrast)"
        },
        "typography": {
          "textDecoration": "none"
        }
      },
      "button": {
        "color": {
          "background": "var(--wp--preset--color--contrast)",
          "text": "var(--wp--preset--color--base)"
        },
        "border": {
          "radius": "50px"
        },
        "spacing": {
          "padding": {
            "top": "0.75rem",
            "bottom": "0.75rem",
            "left": "1.5rem",
            "right": "1.5rem"
          }
        },
        "typography": {
          "fontWeight": "600"
        }
      },
      "heading": {
        "typography": {
          "fontWeight": "800",
          "lineHeight": "1.2"
        },
        "color": {
          "text": "var(--wp--preset--color--contrast)"
        }
      }
    }
  }
}
