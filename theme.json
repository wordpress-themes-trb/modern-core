          "lineHeight": "1.3",
          "letterSpacing": "-0.01em",
          "textTransform": "none"
        }
      },
      "h5": {
        "typography": {
          "fontFamily": "var(--wp--preset--font-family--primary)",
          "fontSize": "var(--wp--preset--font-size--xl)",
          "fontWeight": "700",
          "lineHeight": "1.4",
          "letterSpacing": "0",
          "textTransform": "none"
        }
      },
      "h6": {
        "typography": {
          "fontFamily": "var(--wp--preset--font-family--primary)",
          "fontSize": "var(--wp--preset--font-size--lg)",
          "fontWeight": "700",
          "lineHeight": "1.5",
          "letterSpacing": "0.05em",
          "textTransform": "uppercase"
        }
      },
      "caption": {
        "typography": {
          "fontFamily": "var(--wp--preset--font-family--primary)",
          "fontSize": "var(--wp--preset--font-size--xs)",
          "fontWeight": "400",
          "letterSpacing": "0.025em"
        },
        "color": { "text": "var(--wp--preset--color--neutral-text)" }
      },
      "cite": {
        "typography": {
          "fontStyle": "italic",
          "fontSize": "var(--wp--preset--font-size--sm)"
        },
        "color": { "text": "var(--wp--preset--color--neutral-text)" }
      }
    },

    "blocks": {
      "core/paragraph": {
        "typography": {
          "fontSize": "var(--wp--preset--font-size--base)",
          "lineHeight": "1.65"
        },
        "spacing": {
          "margin": { "bottom": "var(--wp--preset--spacing--lg)" }
        }
      },
      "core/heading": {
        "spacing": {
          "margin": {
            "top": "var(--wp--preset--spacing--3xl)",
            "bottom": "var(--wp--preset--spacing--md)"
          }
        }
      },
      "core/image": {
        "border": { "radius": "var(--wp--custom--border-radius--lg)" }
      },
      "core/quote": {
        "border": {
          "color": "var(--wp--preset--color--accent)",
          "style": "solid",
          "width": "0 0 0 4px"
        },
        "spacing": {
          "padding": {
            "top": "var(--wp--preset--spacing--lg)",
            "bottom": "var(--wp--preset--spacing--lg)",
            "left": "var(--wp--preset--spacing--xl)",
            "right": "var(--wp--preset--spacing--lg)"
          }
        },
        "typography": {
          "fontFamily": "var(--wp--preset--font-family--secondary)",
          "fontSize": "var(--wp--preset--font-size--2xl)",
          "fontStyle": "italic",
          "lineHeight": "1.5"
        }
      },
      "core/pullquote": {
        "typography": {
          "fontFamily": "var(--wp--preset--font-family--secondary)",
          "fontSize": "var(--wp--preset--font-size--3xl)",
          "fontStyle": "italic",
          "fontWeight": "400",
          "lineHeight": "1.4",
          "letterSpacing": "-0.01em"
        },
        "color": { "text": "var(--wp--preset--color--contrast)" }
      },
      "core/code": {
        "typography": {
          "fontFamily": "var(--wp--preset--font-family--mono)",
          "fontSize": "var(--wp--preset--font-size--sm)"
        },
        "color": {
          "background": "var(--wp--preset--color--neutral-light)",
          "text": "var(--wp--preset--color--contrast)"
        },
        "border": {
          "radius": "var(--wp--custom--border-radius--md)",
          "color": "var(--wp--preset--color--neutral-border)",
          "style": "solid",
          "width": "1px"
        },
        "spacing": {
          "padding": {
            "top": "var(--wp--preset--spacing--md)",
            "bottom": "var(--wp--preset--spacing--md)",
            "left": "var(--wp--preset--spacing--lg)",
            "right": "var(--wp--preset--spacing--lg)"
          }
        }
      },
      "core/preformatted": {
        "typography": {
          "fontFamily": "var(--wp--preset--font-family--mono)",
          "fontSize": "var(--wp--preset--font-size--sm)"
        }
      },
      "core/separator": {
        "color": { "text": "var(--wp--preset--color--neutral-border)" }
      },
      "core/table": {
        "typography": {
          "fontFamily": "var(--wp--preset--font-family--primary)",
          "fontSize": "var(--wp--preset--font-size--sm)"
        }
      },
      "core/navigation": {
        "typography": {
          "fontFamily": "var(--wp--preset--font-family--primary)",
          "fontSize": "var(--wp--preset--font-size--sm)",
          "fontWeight": "500",
          "letterSpacing": "0.025em"
        }
      }
    }
  }
}
