{
  "$schema": "https://schemas.wp.org/trunk/block.json",
  "apiVersion": 3,
  "name": "modern-core/columns-builder",
  "title": "Columns Builder",
  "category": "modern-core",
  "icon": "columns",
  "description": "Advanced layout grid system for side-by-side content.",
  "supports": {
    "align": [
      "wide",
      "full"
    ],
    "html": false
  },
  "attributes": {
    "layout": {
      "type": "string",
      "default": "1fr 1fr"
    },
    "gap": {
      "type": "number",
      "default": 30
    },
    "vAlign": {
      "type": "string",
      "default": "start"
    },
    "mobileStack": {
      "type": "string",
      "default": "stack"
    },
    "reverseMobile": {
      "type": "boolean",
      "default": false
    },
    "showDividers": {
      "type": "boolean",
      "default": false
    },
    "dividerColor": {
      "type": "string",
      "default": "#e2e8f0"
    },
    "widthMode": {
      "type": "string",
      "default": "contained",
      "enum": [
        "contained",
        "wide",
        "fullwidth"
      ]
    }
  },
  "textdomain": "modern-core",
  "editorScript": "modern-core-columns-builder-js",
  "render": "file:./render.php"
}
