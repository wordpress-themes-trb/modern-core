{
  "$schema": "https://schemas.wp.org/trunk/block.json",
  "apiVersion": 3,
  "name": "modern-core/cookie-consent",
  "title": "Cookie Consent",
  "category": "modern-core",
  "icon": "shield-alt",
  "description": "GDPR/CCPA compliant privacy interface with preference management.",
  "supports": { "align": false, "html": false },
  "attributes": {
    "consentMode": { "type": "string", "default": "simple" },
    "placementStyle": { "type": "string", "default": "bar" },
    "gateMode": { "type": "boolean", "default": false },
    "gateModeStyle": { "type": "string", "default": "blur" },
    "showModalOverlay": { "type": "boolean", "default": false },
    "message": {
      "type": "string",
      "default": "We use cookies to improve your experience and analyze our traffic."
    },
    "policyLink": { "type": "string", "default": "/privacy-policy" },
    "policyLinkText": { "type": "string", "default": "Privacy Policy" },
    "btnAccept": { "type": "string", "default": "Accept All" },
    "btnDecline": { "type": "string", "default": "Decline" },
    "btnManage": { "type": "string", "default": "Manage Preferences" },
    "cookieDays": { "type": "number", "default": 365 },
    "bgColor": { "type": "string", "default": "#ffffff" },
    "textColor": { "type": "string", "default": "#0f172a" },
    "accentColor": { "type": "string", "default": "#3b82f6" },
    "shadowOpacity": { "type": "number", "default": 10 },
    "widthMode": {
      "type": "string",
      "default": "contained",
      "enum": ["contained", "wide", "fullwidth"]
    }
  },
  "textdomain": "modern-core",
  "editorScript": "modern-core-cookie-consent-js",
  "render": "file:./render.php"
}
