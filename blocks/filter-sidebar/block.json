{
  "$schema": "https://schemas.wp.org/trunk/block.json",
  "apiVersion": 3,
  "name": "modern-core/filter-sidebar",
  "title": "Filter Sidebar",
  "category": "modern-core",
  "icon": "filter",
  "description": "Advanced catalog refinement engine with AJAX filtering.",
  "supports": {
    "align": [
      "wide",
      "full"
    ],
    "html": false
  },
  "attributes": {
    "placementMode": {
      "type": "string",
      "default": "sidebar-left"
    },
    "filters": {
      "type": "array",
      "default": [
        {
          "type": "price",
          "label": "Price",
          "expanded": true
        },
        {
          "type": "color",
          "label": "Colour",
          "attribute": "pa_color",
          "expanded": true
        },
        {
          "type": "pill",
          "label": "Size",
          "attribute": "pa_size",
          "expanded": true
        },
        {
          "type": "status",
          "label": "Availability",
          "expanded": false
        },
        {
          "type": "checkbox",
          "label": "Category",
          "attribute": "product_cat",
          "expanded": true
        }
      ]
    },
    "showCounts": {
      "type": "boolean",
      "default": true
    },
    "showActiveChips": {
      "type": "boolean",
      "default": true
    },
    "chipBgColor": {
      "type": "string",
      "default": "#f1f5f9"
    },
    "chipTextColor": {
      "type": "string",
      "default": "#0f172a"
    },
    "headingColor": {
      "type": "string",
      "default": "#0f172a"
    },
    "accentColor": {
      "type": "string",
      "default": "#3b82f6"
    },
    "widthMode": {
      "type": "string",
      "default": "contained",
      "enum": [
        "contained",
        "wide",
        "fullwidth"
      ]
    }
  },
  "textdomain": "modern-core",
  "editorScript": "modern-core-filter-sidebar-js",
  "render": "file:./render.php"
}
