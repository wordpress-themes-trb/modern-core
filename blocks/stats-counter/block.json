{
  "$schema": "https://schemas.wp.org/trunk/block.json",
  "apiVersion": 3,
  "name": "modern-core/stats-counter",
  "title": "Stats Counter",
  "category": "modern-core",
  "icon": "performance",
  "description": "Animated statistics counter for high-impact social proof.",
  "supports": {
    "align": ["wide", "full"],
    "html": false
  },
  "attributes": {
    "colsDesktop": {
      "type": "number",
      "default": 4
    },
    "colsMobile": {
      "type": "number",
      "default": 2
    },
    "alignment": {
      "type": "string",
      "default": "center"
    },
    "showDividers": {
      "type": "boolean",
      "default": true
    },
    "triggerOnce": {
      "type": "boolean",
      "default": true
    },
    "useGradient": {
      "type": "boolean",
      "default": false
    },
    "color1": {
      "type": "string",
      "default": "#000000"
    },
    "color2": {
      "type": "string",
      "default": "#000000"
    },
    "numberColor": {
      "type": "string",
      "default": "#000000"
    },
    "textColor": {
      "type": "string",
      "default": "#000000"
    },
    "borderColor": {
      "type": "string",
      "default": "#e2e8f0"
    },
    "stats": {
      "type": "array",
      "default": [
        {
          "prefix": "",
          "number": "50",
          "suffix": "K+",
          "label": "Happy Customers",
          "icon": "users",
          "customIcon": "",
          "duration": 2000
        },
        {
          "prefix": "",
          "number": "4.9",
          "suffix": "",
          "label": "Average Rating",
          "icon": "star",
          "customIcon": "",
          "duration": 1500
        },
        {
          "prefix": "",
          "number": "12",
          "suffix": "",
          "label": "Years Experience",
          "icon": "award",
          "customIcon": "",
          "duration": 2500
        },
        {
          "prefix": "",
          "number": "99",
          "suffix": "%",
          "label": "Satisfaction Rate",
          "icon": "smile",
          "customIcon": "",
          "duration": 2000
        }
      ]
    }
  },
  "textdomain": "modern-core",
  "editorScript": "modern-core-stats-counter-js",
  "render": "file:./render.php"
}
