{
    "$schema": "https://schemas.wp.org/trunk/block.json",
    "apiVersion": 3,
    "name": "modern-core/section-wrapper",
    "title": "Section Layout System",
    "category": "modern-core",
    "icon": "layout",
    "description": "A complete, user-friendly layout container with column controls, omni-directional padding, and mobile stacking.",
    "supports": {
        "align": [
            "wide",
            "full"
        ],
        "html": false,
        "anchor": true,
        "customClassName": true
    },
    "attributes": {
        "wrapperWidth": {
            "type": "string",
            "default": "full",
            "enum": [
                "contained",
                "full"
            ]
        },
        "contentWidth": {
            "type": "string",
            "default": "contained",
            "enum": [
                "contained",
                "wide",
                "fullwidth"
            ]
        },
        "layoutStyle": {
            "type": "string",
            "default": "standard"
        },
        "columnCount": {
            "type": "number",
            "default": 1
        },
        "rowCount": {
            "type": "number",
            "default": 1
        },
        "columnGap": {
            "type": "number",
            "default": 30
        },
        "rowGap": {
            "type": "number",
            "default": 30
        },
        "stackOnMobile": {
            "type": "boolean",
            "default": true
        },
        "paddingTopDesktop": {
            "type": "number",
            "default": 80
        },
        "paddingBottomDesktop": {
            "type": "number",
            "default": 80
        },
        "paddingLeftDesktop": {
            "type": "number",
            "default": 0
        },
        "paddingRightDesktop": {
            "type": "number",
            "default": 0
        },
        "paddingTopMobile": {
            "type": "number",
            "default": 40
        },
        "paddingBottomMobile": {
            "type": "number",
            "default": 40
        },
        "paddingLeftMobile": {
            "type": "number",
            "default": 20
        },
        "paddingRightMobile": {
            "type": "number",
            "default": 20
        },
        "bgType": {
            "type": "string",
            "default": "transparent"
        },
        "bgColor": {
            "type": "string",
            "default": "transparent"
        },
        "textColor": {
            "type": "string",
            "default": "inherit"
        },
        "bgImageUrl": {
            "type": "string",
            "default": ""
        },
        "bgOverlayOpacity": {
            "type": "number",
            "default": 0
        },
        "topShape": {
            "type": "string",
            "default": "none"
        },
        "bottomShape": {
            "type": "string",
            "default": "none"
        },
        "shapeHeight": {
            "type": "number",
            "default": 50
        },
        "shapeColor": {
            "type": "string",
            "default": "#ffffff"
        },
        "borderType": {
            "type": "string",
            "default": "none"
        },
        "borderColor": {
            "type": "string",
            "default": "#e2e8f0"
        },
        "borderRadius": {
            "type": "number",
            "default": 0
        },
        "hasShadow": {
            "type": "boolean",
            "default": false
        },
        "overflowHidden": {
            "type": "boolean",
            "default": false
        },
        "hideWhenEmpty": {
            "type": "boolean",
            "default": false
        },
        "widthMode": {
            "type": "string",
            "default": "wide",
            "enum": [
                "contained",
                "wide",
                "fullwidth"
            ]
        }
    },
    "textdomain": "modern-core",
    "editorScript": "modern-core-section-wrapper-js",
    "render": "file:./render.php"
}
