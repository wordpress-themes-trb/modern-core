{
  "$schema": "https://schemas.wp.org/trunk/block.json",
  "apiVersion": 3,
  "name": "modern-core/slide",
  "title": "Slide Canvas",
  "category": "modern-core",
  "icon": "format-image",
  "description": "A highly flexible hero canvas or individual slide component.",
  "attributes": {
    "bgColor": {
      "type": "string",
      "default": "#000000"
    },
    "bgImageUrl": {
      "type": "string",
      "default": ""
    },
    "overlayOpacity": {
      "type": "number",
      "default": 50
    }
  },
  "textdomain": "modern-core",
  "editorScript": "modern-core-slide-js",
  "render": "file:./render.php"
}
