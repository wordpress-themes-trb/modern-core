{
    "$schema": "https://schemas.wp.org/trunk/block.json",
    "apiVersion": 3,
    "name": "modern-core/shipping-progress",
    "title": "Free Shipping Progress",
    "category": "modern-core",
    "icon": "performance",
    "description": "Dynamic AOV motivator connecting live to WooCommerce cart totals.",
    "supports": {
        "align": [
            "wide",
            "full"
        ],
        "html": false
    },
    "attributes": {
        "threshold": {
            "type": "number",
            "default": 100
        },
        "msgPending": {
            "type": "string",
            "default": "Add {amount} more for free shipping!"
        },
        "msgSuccess": {
            "type": "string",
            "default": "\ud83c\udf89 You qualify for free shipping!"
        },
        "barHeight": {
            "type": "number",
            "default": 8
        },
        "barRadius": {
            "type": "number",
            "default": 4
        },
        "trackColor": {
            "type": "string",
            "default": "#e2e8f0"
        },
        "fillColor": {
            "type": "string",
            "default": "#3b82f6"
        },
        "successColor": {
            "type": "string",
            "default": "#10b981"
        },
        "textColor": {
            "type": "string",
            "default": "#0f172a"
        },
        "useGradient": {
            "type": "boolean",
            "default": false
        },
        "widthMode": {
            "type": "string",
            "default": "contained",
            "enum": [
                "contained",
                "wide",
                "fullwidth"
            ]
        }
    },
    "textdomain": "modern-core",
    "editorScript": "modern-core-shipping-progress-js",
    "render": "file:./render.php"
}
