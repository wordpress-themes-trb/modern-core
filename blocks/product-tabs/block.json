{
  "$schema": "https://schemas.wp.org/trunk/block.json",
  "apiVersion": 3,
  "name": "modern-core/product-tabs",
  "title": "Product Tabs",
  "category": "modern-core",
  "icon": "index-card",
  "description": "Dynamic, multi-query product discovery organized into interactive tabs.",
  "supports": {
    "align": ["wide", "full"],
    "html": false
  },
  "attributes": {
    "sectionTitle": {
      "type": "string",
      "default": "Shop by Collection"
    },
    "sectionSubtitle": {
      "type": "string",
      "default": "Curated for you"
    },
    "tabStyle": {
      "type": "string",
      "default": "pill"
    },
    "tabAlignment": {
      "type": "string",
      "default": "center"
    },
    "animationStyle": {
      "type": "string",
      "default": "fade"
    },
    "tabsData": {
      "type": "array",
      "default": [
        {
          "label": "New Arrivals",
          "query": "recent",
          "categoryId": 0,
          "count": 4
        },
        {
          "label": "Best Sellers",
          "query": "popularity",
          "categoryId": 0,
          "count": 4
        },
        {
          "label": "On Sale",
          "query": "sale",
          "categoryId": 0,
          "count": 4
        }
      ]
    },
    "colsDesktop": {
      "type": "number",
      "default": 4
    },
    "colsMobile": {
      "type": "number",
      "default": 2
    },
    "imageRatio": {
      "type": "string",
      "default": "3/4"
    },
    "cardBg": {
      "type": "string",
      "default": "#ffffff"
    },
    "cardRadius": {
      "type": "number",
      "default": 8
    },
    "accentColor": {
      "type": "string",
      "default": "#000000"
    },
    "inactiveColor": {
      "type": "string",
      "default": "#64748b"
    }
  },
  "textdomain": "modern-core",
  "editorScript": "modern-core-product-tabs-js",
  "render": "file:./render.php"
}
